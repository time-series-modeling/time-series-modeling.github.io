---
import type { Translations, SupportedLocale } from '../i18n';
import { localePath } from '../i18n';
import { PACKT_2026_11 } from '../data/workshops';

interface Props {
  t: Translations;
  locale: SupportedLocale;
}

const { t, locale } = Astro.props;
const w = t.workshop;
const base = PACKT_2026_11.day2;
---

<div class="py-16">
  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
    <div class="text-center">
      <h1 class="text-4xl font-extrabold tracking-tight text-slate-900 sm:text-5xl">{w.title}</h1>
      <p class="mt-4 text-lg text-slate-500">{w.subtitle}</p>
      <p class="mx-auto mt-4 max-w-3xl text-base text-slate-600">{w.intro}</p>
    </div>

    <h2 class="mt-14 text-2xl font-bold text-slate-900">{w.videosTitle}</h2>
    <div class="mt-6 grid gap-8 md:grid-cols-2">
      {
        w.videos.map((v) => (
          <figure class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
            <video
              class="aspect-video w-full bg-slate-100"
              src={`${base}/videos/${v.file}`}
              autoplay
              muted
              loop
              playsinline
              controls
              preload="metadata"
              aria-label={v.title}
            />
            <figcaption class="p-4">
              <p class="font-semibold text-slate-900">{v.title}</p>
              <p class="mt-1 text-sm text-slate-500">{v.desc}</p>
            </figcaption>
          </figure>
        ))
      }
    </div>

    <h2 class="mt-16 text-2xl font-bold text-slate-900">{w.explore}</h2>
    <div class="mt-6 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
      {
        (['data', 'methods', 'models', 'results', 'embedding'] as const).map((k) => (
          <a
            href={localePath(locale, `${base}/${k}`)}
            class="group rounded-xl border border-slate-200 bg-white p-6 shadow-sm transition hover:border-primary-300 hover:shadow-md"
          >
            <p class="text-lg font-semibold text-slate-900 group-hover:text-primary-600">{w.pages[k].title}</p>
            <p class="mt-2 text-sm text-slate-500">{w.pages[k].card}</p>
          </a>
        ))
      }
    </div>
  </div>
</div>
