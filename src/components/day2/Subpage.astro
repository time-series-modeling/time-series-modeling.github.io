---
import type { Translations, SupportedLocale } from '../../i18n';
import { localePath } from '../../i18n';
import '../../styles/day2.css';

interface Props {
  t: Translations;
  locale: SupportedLocale;
  page: 'data' | 'methods' | 'models' | 'results';
}

const { t, locale, page } = Astro.props;
const w = t.workshop;
const order = ['data', 'methods', 'models', 'results'] as const;
---

<div class="py-12">
  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
    <a href={localePath(locale, '/workshops/day2')} class="text-sm text-primary-600 hover:underline">← {w.back}</a>
    <h1 class="mt-4 text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl">{w.pages[page].title}</h1>
    <p class="mt-3 max-w-3xl text-base text-slate-600">{w.pages[page].lede}</p>
    <nav class="mt-6 flex flex-wrap gap-2" aria-label={w.explore}>
      {
        order.map((k) => (
          <a
            href={localePath(locale, `/workshops/day2/${k}`)}
            class:list={[
              'rounded-full border px-4 py-1.5 text-sm',
              k === page ? 'border-primary-600 bg-primary-600 text-white' : 'border-slate-200 text-slate-700 hover:border-primary-300',
            ]}
          >
            {w.pages[k].title.split('·').pop()?.trim()}
          </a>
        ))
      }
    </nav>
    <div class="mt-8">
      <slot />
    </div>
    <p class="mt-12 text-xs text-slate-400">{w.footnote}</p>
  </div>
</div>

<script>
  import '../../scripts/day2-widgets.js';
  import '../../scripts/day2-models.js';
</script>
