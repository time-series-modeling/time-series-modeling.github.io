---
import Layout from '../../../../layouts/Layout.astro';
import Subpage from '../../../../components/day2/Subpage.astro';
import Results from '../../../../components/day2/Results.astro';
import { getTranslations } from '../../../../i18n';

const t = getTranslations('en');
const locale = 'en' as const;
---

<Layout t={t} locale={locale} title={t.workshop.pages.results.title} description={t.workshop.pages.results.lede} currentPath="/workshops/packt-2026-11/day2/results">
  <Subpage t={t} locale={locale} page="results">
    <Results />
  </Subpage>
</Layout>
